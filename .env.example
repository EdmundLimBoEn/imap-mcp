# Copy to .env and fill in. Never commit .env.
MCP_BEARER_TOKEN=change-me-generate-with-openssl-rand-hex-32
PORT=8787
# IP to publish on in docker-compose (e.g. your Tailscale IP). Placeholder:
BIND_IP=127.0.0.1
MAX_BODY_CHARS=20000

IMAP_ACCOUNTS=work,personal

IMAP_WORK_HOST=imap.example.com
IMAP_WORK_PORT=993
IMAP_WORK_TLS=true
IMAP_WORK_USER=user@example.com
IMAP_WORK_PASS=app-password-here
# Optional SMTP for send_message (reuses USER/PASS)
IMAP_WORK_SMTP_HOST=smtp.example.com
IMAP_WORK_SMTP_PORT=465
# IMAP_WORK_SMTP_TLS=true
# IMAP_WORK_SENT=Sent

IMAP_PERSONAL_HOST=imap.example.org
IMAP_PERSONAL_PORT=993
IMAP_PERSONAL_TLS=true
IMAP_PERSONAL_USER=user@example.org
IMAP_PERSONAL_PASS=app-password-here


# Optional From override: sets the From header and SMTP envelope sender.
# Auth still uses USER/PASS. Useful for iCloud+ custom domains.
# IMAP_WORK_FROM=you@custom-domain.example

# iCloud+ custom domain example. USER is the primary iCloud address;
# PASS is an Apple app-specific password; FROM is the custom-domain address.
# Add `icloud` to IMAP_ACCOUNTS to enable this block.
# IMAP_ICLOUD_HOST=imap.mail.me.com
# IMAP_ICLOUD_PORT=993
# IMAP_ICLOUD_TLS=true
# IMAP_ICLOUD_USER=your-primary-address@icloud.com
# IMAP_ICLOUD_PASS=app-specific-password
# IMAP_ICLOUD_SMTP_HOST=smtp.mail.me.com
# IMAP_ICLOUD_SMTP_PORT=587
# IMAP_ICLOUD_SMTP_TLS=false
# IMAP_ICLOUD_SENT=Sent Messages
# IMAP_ICLOUD_FROM=edmund@k0edl.com

# Global gate for sending. When false (default) send_message is not registered.
SMTP_ENABLED=false
