# Copy to .env and fill in. Never commit .env.
MCP_BEARER_TOKEN=change-me-generate-with-openssl-rand-hex-32
PORT=8787
# IP to publish on in docker-compose (e.g. your Tailscale IP). Placeholder:
BIND_IP=127.0.0.1
MAX_BODY_CHARS=20000

IMAP_ACCOUNTS=work,personal

IMAP_WORK_HOST=imap.example.com
IMAP_WORK_PORT=993
IMAP_WORK_TLS=true
IMAP_WORK_USER=user@example.com
IMAP_WORK_PASS=app-password-here
# Optional SMTP for send_message (reuses USER/PASS)
IMAP_WORK_SMTP_HOST=smtp.example.com
IMAP_WORK_SMTP_PORT=465
# IMAP_WORK_SMTP_TLS=true
# IMAP_WORK_SENT=Sent

IMAP_PERSONAL_HOST=imap.example.org
IMAP_PERSONAL_PORT=993
IMAP_PERSONAL_TLS=true
IMAP_PERSONAL_USER=user@example.org
IMAP_PERSONAL_PASS=app-password-here

# Global gate for sending. When false (default) send_message is not registered.
SMTP_ENABLED=false
